<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp">

    <ru.btmessenger.app.DirectionView
        android:id="@+id/directionArrow"
        android:layout_width="200dp"
        android:layout_height="200dp" />

    <TextView
        android:id="@+id/directionDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/directionBearing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:textColor="@color/tg_accent"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/directionHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp"
        android:paddingTop="12dp"
        android:textColor="@color/tg_secondary"
        android:textSize="13sp" />
</LinearLayout>
